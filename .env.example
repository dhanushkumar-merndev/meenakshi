# Public values are embedded into browser bundles at build time. Set them in
# both the build and runtime environments. They are identifiers, not secrets.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Runtime-only secret. Never prefix this with NEXT_PUBLIC, pass it as a Docker
# build argument, or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# CLI/import values. They are not needed by the web server.
SUPABASE_PROJECT_ID=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_POOLER_HOST=

APP_TIMEZONE=Asia/Kolkata
PATIENT_DOCUMENT_MAX_BYTES=1048576
EXPORT_RETENTION_DAYS=0

# Set to the immutable release/commit identifier shown by the health endpoint.
DEPLOYMENT_VERSION=
NEXT_TELEMETRY_DISABLED=1

# Required only when self-hosting more than one app replica. Generate once with
# `openssl rand -base64 32` and give the same value to every replica.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Server-only Geoapify Address Autocomplete API key.
AUTO_COMPLETE_API=

# Optional. Free client credentials from https://icd.who.int/icdapi (your own
# registration -- WHO issues these per organisation, nobody else's will work).
# When set, a diagnosis search that finds nothing in the local Clinical
# Directory falls back to WHO's live ICD-10 API and caches the result locally,
# so the same query is a database hit next time. Leave both blank to disable
# the fallback entirely -- the local directory keeps working on its own.
WHOS_CLIENT=
WHOS_SECRET=

# One-time first-admin bootstrap. Leave blank except while running
# `pnpm db:create-first-admin`, then remove the password from the environment.
FIRST_ADMIN_NAME=
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=

# Playwright E2E sign-in. Local/staging accounts only -- never production.
E2E_PASSWORD=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# Display name of the doctor linked to the E2E doctor account.
E2E_DOCTOR_NAME=
