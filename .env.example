# Public Supabase project values. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix this with NEXT_PUBLIC and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Optional for CLI scripts/deployment. Prefer `supabase link` for remote projects.
SUPABASE_PROJECT_ID=
SUPABASE_DB_PASSWORD=

APP_TIMEZONE=Asia/Kolkata
NEXT_PUBLIC_APP_URL=http://localhost:3000
PATIENT_DOCUMENT_MAX_BYTES=1048576

# Server-only Geoapify Address Autocomplete API key.
AUTO_COMPLETE_API=

EXPORT_RETENTION_DAYS=0

# Playwright E2E sign-in. Local/staging accounts only -- never production.
E2E_PASSWORD=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# Display name of the doctor linked to the E2E doctor account.
E2E_DOCTOR_NAME=
